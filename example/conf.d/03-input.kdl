// ─────────────────────────────────────────
// 03 · INPUT
// ─────────────────────────────────────────

input {
    keyboard {
        xkb {
            layout "us,latam"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
    }

    mouse {
        // natural-scroll
        // accel-speed 0.2
    }

    // warp-mouse-to-focus
    // focus-follows-mouse max-scroll-amount="0%"
}
